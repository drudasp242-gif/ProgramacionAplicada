<Window x:Class="TareaConecta4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TareaConecta4"
        mc:Ignorable="d"
        Title="Conecta 4" Height="720" Width="980"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#1E293B" Foreground="White" FontSize="13">
            <MenuItem Header="_Juego">
                <MenuItem Header="_Nuevo Juego" Click="BtnNuevoJuego_Click" />
                <Separator />
                <MenuItem Header="_Salir" Click="MnuSalir_Click" />
            </MenuItem>
            <MenuItem Header="_Opciones">
                <MenuItem Header="_Limpiar Historial" Click="BtnLimpiarHistorial_Click" />
            </MenuItem>
            <MenuItem Header="_Ayuda">
                <MenuItem Header="_Acerca de..." Click="MnuAcercaDe_Click" />
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top" Background="#E2E8F0" Height="40">
            <Button Click="BtnNuevoJuego_Click" ToolTip="Iniciar Nueva Partida">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nuevo Juego" FontWeight="Bold" Margin="5,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="BtnResetContadores_Click" ToolTip="Reiniciar Marcador de Victorias">
                <TextBlock Text="Reset Marcador" Margin="5,0"/>
            </Button>
        </ToolBar>
        <Border DockPanel.Dock="Left" Width="280" Background="White" Margin="10" CornerRadius="8" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Configuracion del Juego" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8" Margin="0,0,0,12" BorderBrush="#BFDBFE" BorderThickness="1">
                        <CheckBox x:Name="ChkModoIA" Content="Jugar con la IA" FontWeight="Bold" Foreground="#1E40AF" Checked="ChkModoIA_Changed" Unchecked="ChkModoIA_Changed"/>
                    </Border>
                    <TextBlock Text="Jugador 1 (Rojo):" Margin="0,5,0,2" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtJugador1" Text="Alumno UNC 1" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Jugador 2 (Amarillo):" Margin="0,5,0,2" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtJugador2" Text="Alumno UNC 2" Padding="5" Margin="0,0,0,15"/>

                    <CheckBox x:Name="ChkTemporizador" Content="Habilitar límite de tiempo" IsChecked="True" 
                              Checked="ChkTemporizador_Changed" Unchecked="ChkTemporizador_Changed" Margin="0,0,0,8"/>

                    <TextBlock Text="Tiempo por turno (seg):" Margin="0,5,0,2"/>
                    <ComboBox x:Name="CboTiempoTurno" SelectionChanged="CboTiempoTurno_SelectionChanged" Margin="0,0,0,15">
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="10" IsSelected="True" />
                        <ComboBoxItem Content="15" />
                        <ComboBoxItem Content="20" />
                    </ComboBox>
                    <GroupBox Header="Inicia la partida" Margin="0,0,0,15" Padding="5">
                        <StackPanel>
                            <RadioButton x:Name="RbIniciaRojo" Content="Jugador 1 (Rojo)" IsChecked="True"/>
                            <RadioButton x:Name="RbIniciaAmarillo" Content="Jugador 2 (Amarillo)" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Button x:Name="BtnNuevoJuego" Content="Reiniciar Partida" Click="BtnNuevoJuego_Click" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,0,0,15"/>

                    <Separator Margin="0,5"/>
                    <TextBlock x:Name="LblTurnoActual" Text="Turno: Jugador 1" FontSize="14" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,5"/>
                    <TextBlock x:Name="LblTiempo" Text="Tiempo restante: 10s" FontSize="14" FontWeight="SemiBold" Foreground="#FFF5D70B" Margin="0,0,0,15"/>
                    <Separator Margin="0,5"/>
                    <TextBlock Text="Historial de Movimientos:" FontWeight="Bold" Margin="0,5,0,5"/>
                    <ListBox x:Name="LstHistorial" Height="130" FontSize="11" Background="#F8FAFC"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblMarcadorRojo" Grid.Column="0" Text="Rojo: 0" Foreground="#EF4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblMarcadorAmarillo" Grid.Column="1" Text="Amarillo: 0" Foreground="#FFF5D70B" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" CornerRadius="12" Padding="15" Background="#1D4ED8">
                <Grid x:Name="GridTablero">
                </Grid>

            </Border>
        </Grid>
    </DockPanel>
</Window>
