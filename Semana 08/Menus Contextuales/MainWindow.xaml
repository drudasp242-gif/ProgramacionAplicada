<Window x:Class="Menus_Contextuales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Menus_Contextuales"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Hacer Click Derecho&#xD;&#xA;" HorizontalAlignment="Center" Margin="0,190,0,0" VerticalAlignment="Top" Height="28" RenderTransformOrigin="0.5,0.5">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Menu Item 1"/>
                    <MenuItem Header="Menu Item 2"/>
                    <Separator />
                    <MenuItem Header="Menu Item 3"/>

                </ContextMenu>
            </Button.ContextMenu>
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.416"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <TextBox Text="Hacer CLick aqui para el menu contextual" Margin="275,269,275,102" >
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command = "Cut">
                        <MenuItem.Icon>
                            <Image Source="/1150823.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="Copy">
                        <MenuItem.Icon>
                            <Image Source="/R.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    
                    
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        

    </Grid>
</Window>
